{
  "contract": "e10-t5c3-dashboard-ui",
  "status": "frozen",
  "module": "Dashboard",
  "purpose": "manager_summary",
  "time": {
    "preset_completed_days": [7, 14, 30, 90],
    "includes_today": false,
    "custom_range": false,
    "authority": "backend_shop_timezone"
  },
  "comparison": {
    "control": "on_off_only",
    "custom_dates": false,
