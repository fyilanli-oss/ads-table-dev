    "action_label": "Reconnect Meta",
    "token_or_provider_body_exposed": false
  },
  "account_selection": {
    "minimum": 1,
    "maximum": 3,
    "provider_refetch_required": true,
    "connected_before_selection": false
  },
  "implementation": [
    "src/shopify/embedded-provider-token-exchange.js",
    "src/shopify/embedded-provider-strategies.js",
    "src/shopify/runtime.js",
    "src/routes/shopify-provider-oauth-routes.js",
    "src/shopify/embedded-app-home.js",
    "src/shopify/ad-account-ui.js"
  ],
  "official_reference": "https://www.postman.com/meta/facebook-marketing-api/documentation/0zr4mes/facebook-marketing-api-mapi",
