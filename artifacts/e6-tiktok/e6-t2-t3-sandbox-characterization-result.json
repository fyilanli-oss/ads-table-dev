    { "metric": "checkout", "accepted": true, "field_present": false, "result_shape": "zero_row" },
    { "metric": "checkout_value", "accepted": true, "field_present": false, "result_shape": "zero_row" },
    { "metric": "initiate_checkout", "accepted": true, "field_present": false, "result_shape": "zero_row" },
    { "metric": "initiate_checkout_value", "accepted": true, "field_present": false, "result_shape": "zero_row" },
    { "metric": "complete_payment", "accepted": true, "field_present": false, "result_shape": "zero_row" },
    { "metric": "complete_payment_count", "accepted": true, "field_present": false, "result_shape": "zero_row" },
    { "metric": "complete_payment_value", "accepted": true, "field_present": false, "result_shape": "zero_row" }
  ]
