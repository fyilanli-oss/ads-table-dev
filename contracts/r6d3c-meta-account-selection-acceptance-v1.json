{
  "contract_version": "r6d3c-meta-account-selection-acceptance-v1",
  "status": "PASS_REPOSITORY_PREFLIGHT_PRODUCTION_ACCEPTANCE_PENDING",
  "provider": "meta",
  "business_outcome": "A verified Meta authorization becomes Connected only after the merchant selects between one and three Meta-supplied ad accounts.",
  "reuse_decision": {
    "existing_runtime": "R7-A2 canonical account-selection runtime",
    "new_account_selection_runtime_required": false,
    "legacy_server_dashboard_runtime_reactivated": false
  },
  "merchant_flow": [
    "oauth_callback_creates_pending_account_selection",
    "shopify_native_account_modal_opens",
    "merchant_selects_one_to_three_accounts",
    "server_refetches_meta_accounts",
    "server_accepts_only_verified_account_ids",
    "canonical_connection_becomes_connected",
    "selected_accounts_remain_visible_after_reload"
  ],
  "authority": {
    "workspace_source": "verified_shopify_session",
    "account_identity_source": "meta_me_adaccounts",
    "browser_fields_are_authority": false,
    "server_refetch_on_save": true
  },
  "cardinality": {
    "minimum": 1,
    "maximum": 3,
    "duplicates_allowed": false,
    "database_constraint": "workspace_provider_connected_account_count"
  },
  "canonical_persistence": {
    "table": "public.workspace_provider_connections",
    "pending_status": "pending_account_selection",
    "connected_status": "connected",
    "selected_accounts_column": "selected_accounts",
    "primary_compatibility_column": "active_account_id",
    "optimistic_version_guard": true
  },
  "shopify_ui": {
    "surface": "/shopify/app/platforms",
    "component": "s-choice-list",
    "multiple": true,
    "modal": "s-modal",
    "connected_before_save": false
  },
  "official_shopify_references": [
    "https://shopify.dev/docs/api/app-home/latest/web-components/forms/choice-list",
    "https://shopify.dev/docs/apps/build/app-home/migrate-from-polaris-react"
  ],
  "excluded": [
    "production_meta_oauth",
    "live_meta_account_selection",
    "provider_performance_read",
    "dataset_v2_write",
    "schedule_or_backfill",
    "disconnect_or_revoke",
    "google_ads_acceptance",
    "e4_redevelopment"
  ],
  "production_mutation": false,
  "provider_contact": false,
  "dataset_v2_write": false
}
