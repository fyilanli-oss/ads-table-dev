{
  "contract": "r5-klaviyo-consolidation",
  "version": 1,
  "authority": {
    "tenant_key": "workspace_id",
    "canonical_connection_key": ["workspace_id", "provider"],
    "legacy_binding_key": ["legacy_user_id", "workspace_id"],
    "provider": "klaviyo"
  },
  "gates": [
    {
      "id": "R5-A",
      "name": "explicit_legacy_binding",
      "requirements": [
        "binding_is_human_attested",
        "one_active_workspace_per_legacy_user",
        "no_email_domain_or_account_id_derived_tenant",
        "server_only_storage"
      ]
    },
    {
      "id": "R5-B",
      "name": "provider_account_verification",
      "requirements": [
        "embedded_token_is_decrypted_only_server_side",
        "klaviyo_accounts_api_is_read_only",
        "selected_account_is_returned_by_provider",
        "provider_contact_requires_explicit_approval"
      ]
    },
    {
      "id": "R5-C",
      "name": "canonical_consolidation",
      "requirements": [
        "R5-A_and_R5-B_pass",
        "copy_compatible_encrypted_envelopes_without_plaintext_logging",
        "canonical_row_is_connected_and_verified",
        "legacy_connection_is_locally_disabled",
        "no_provider_revoke",
        "no_token_or_history_deletion"
      ]
    }
  ],
  "forbidden": [
    "derive_workspace_from_email",
    "derive_workspace_from_shop_domain",
    "derive_workspace_from_provider_account_id",
    "auto_bind_single_remaining_workspace",
    "provider_revoke_before_acceptance",
    "delete_legacy_token_envelopes",
    "run_legacy_and_canonical_refresh_concurrently"
  ]
}
