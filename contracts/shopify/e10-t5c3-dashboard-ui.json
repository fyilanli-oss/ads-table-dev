    { "stage": "add_to_cart", "count": "add_to_cart", "value": "add_to_cart_value" },
    { "stage": "checkout", "count": "checkout", "value": "checkout_value" },
    { "stage": "abandoned", "count": "abandoned", "value": "abandoned_value" },
    { "stage": "purchase", "count": "purchase", "value": "sales" }
  ],
  "compare_fields_per_count_and_value": ["current", "comparison", "change"],
  "navigation": {
    "funnel_table_switch_on_dashboard": false,
    "funnel_drilldown": "view_funnel_preserve_context"
  },
  "shared_context": ["time_range", "comparison", "filters", "currency", "data_sources"],
  "excluded": ["attribution_overlap", "creative", "provider_hierarchy_table", "frontend_formulas", "fake_zero"]
